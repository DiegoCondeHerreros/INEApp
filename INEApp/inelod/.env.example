# INELODApp API — Configuración
# Copia este archivo a .env y ajusta los valores según tu entorno

# Virtuoso SPARQL Endpoint
VIRTUOSO_ENDPOINT=https://stats.linkeddata.es/sparql

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True
API_LOG_LEVEL=info

# CORS
CORS_ORIGINS=["*"]

# Database
VIRTUOSO_USER=dba
VIRTUOSO_PASS=dba
