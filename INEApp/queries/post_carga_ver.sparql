# 1. Conteo total de observaciones
SELECT (COUNT(*) AS ?n)
FROM <http://lod.ine.es/recurso/cubes/adrh>
WHERE { ?obs a qb:Observation }

# 2. Conteo por nivel territorial
SELECT ?dim (COUNT(?obs) AS ?n)
FROM <http://lod.ine.es/recurso/cubes/adrh>
WHERE {
  ?obs a qb:Observation .
  VALUES ?dim { ine:municipality ine:districts ine:censusSection }
  ?obs ?dim ?t .
}
GROUP BY ?dim
# Esperado aproximado para Madrid:
#   ine:municipality:   ~ 12-14   (1 muni × 7 medidas × 2 años = 14)
#   ine:districts:      ~ 252-294 (21 × 7 × 2)
#   ine:censusSection:  ~ 30.000-34.000 (~2400 secciones × 7 × 2)

# 3. Renta media por persona en Centro (Lavapiés vive aquí), año 2023
SELECT ?sec ?label ?renta
FROM <http://lod.ine.es/recurso/cubes/adrh>
WHERE {
  ?obs ine:censusSection ?sec ;
       sdmx-dimension:refPeriod "2023"^^xsd:gYear ;
       ine:eurosPerInhabitant ?renta .
  ?sec skos:broader <http://lod.ine.es/kos/distritos/DISTRITOS/2807901> ;
       skos:prefLabel ?label .
}
ORDER BY ?renta
LIMIT 20
# Esperado: valores entre ~8.000 y ~22.000 euros, con las secciones
# de Lavapiés-Embajadores en la parte baja-media

# 4. Sanity check: edad media de Madrid municipio en 2023
SELECT ?edad
FROM <http://lod.ine.es/recurso/cubes/adrh>
WHERE {
  ?obs ine:municipality <http://lod.ine.es/kos/municipios/MUNICIPIOS/28079> ;
       sdmx-dimension:refPeriod "2023"^^xsd:gYear ;
       ine:meanAge ?edad .
}
# Esperado: ~ 44-45 años

###### Consultas adicionales para validar 37727 ##########
# 1. Distritos de Madrid ordenados por Gini en 2023
SELECT ?dist ?label ?gini
FROM <http://lod.ine.es/recurso/cubes/adrh>
WHERE {
  ?obs ine:districts ?dist ;
       sdmx-dimension:refPeriod "2023"^^xsd:gYear ;
       ine:giniIndex ?gini .
  ?dist skos:prefLabel ?label .
}
ORDER BY DESC(?gini)
# Esperado: valores entre 25 y 45 (recordemos que Gini × 100).
# Los distritos con mayor desigualdad interna suelen ser Centro y
# Salamanca por la coexistencia de rentas muy altas y muy bajas.

# 2. Variación del Gini 2022 → 2023 a nivel distrito
SELECT ?dist ?label ?gini22 ?gini23 (ROUND((?gini23 - ?gini22) * 10) / 10 AS ?delta)
FROM <http://lod.ine.es/recurso/cubes/adrh>
WHERE {
  ?obs22 ine:districts ?dist ;
         sdmx-dimension:refPeriod "2022"^^xsd:gYear ;
         ine:giniIndex ?gini22 .
  ?obs23 ine:districts ?dist ;
         sdmx-dimension:refPeriod "2023"^^xsd:gYear ;
         ine:giniIndex ?gini23 .
  ?dist skos:prefLabel ?label .
}
ORDER BY DESC(?delta)