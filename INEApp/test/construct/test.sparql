PREFIX xyz:  <http://sparql.xyz/facade-x/data/>
PREFIX fx:   <http://sparql.xyz/facade-x/ns/>
PREFIX ine:  <https://lod.ine.es/def/vocabulary/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

CONSTRUCT {
  ?territorio a skos:Concept ;
              skos:notation ?codigo ;
              skos:prefLabel ?nombre .
}
WHERE {
  SERVICE <x-sparql-anything:location=data/test-adrh.csv,csv.headers=true,csv.delimiter=;> {
    [] xyz:Municipios ?muniRaw ;
       xyz:Distritos  ?distRaw ;
       xyz:Secciones  ?secRaw ;
       xyz:Total      ?totalRaw .
  }

  BIND (REPLACE(?totalRaw, "^\\s+|\\s+$", "") AS ?totalLimpio)
  FILTER (?totalLimpio != "")
  FILTER (?totalLimpio != ".")

  BIND (
    IF (?secRaw  != "", ?secRaw,
    IF (?distRaw != "", ?distRaw,
                        ?muniRaw))
    AS ?territorioRaw)

  BIND (REPLACE(?territorioRaw, "^([0-9]+)\\s+.*$", "$1") AS ?codigo)
  BIND (REPLACE(?territorioRaw, "^[0-9]+\\s+(.*)$", "$1") AS ?nombre)
  BIND (IRI(CONCAT("https://example.org/", ?codigo)) AS ?territorio)
}