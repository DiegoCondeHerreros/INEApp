##############################################################################
# CONSTRUCT — Tabla 31105 del INE
# Indicadores demográficos — Madrid (municipio, distritos, secciones)
#
# Fichero esperado: data/raw/adrh-31105-madrid.csv
# Codificación:     ISO-8859-15
# Separador:        ;
# Decimal:          coma — separador de millares: punto
#
# Salida: observaciones QB con dimensión territorial (municipio/distrito/sección)
#         + refPeriod, con siete medidas demográficas del cubo ADRH.
##############################################################################

PREFIX xyz:             <http://sparql.xyz/facade-x/data/>
PREFIX fx:              <http://sparql.xyz/facade-x/ns/>
PREFIX qb:              <http://purl.org/linked-data/cube#>
PREFIX ine:             <https://lod.ine.es/def/vocabulary/>
PREFIX sdmx-dimension:  <http://purl.org/linked-data/sdmx/2009/dimension#>
PREFIX sdmx-attribute:  <http://purl.org/linked-data/sdmx/2009/attribute#>
PREFIX skos:            <http://www.w3.org/2004/02/skos/core#>
PREFIX rdf:             <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:             <http://www.w3.org/2001/XMLSchema#>


CONSTRUCT {
  ?territorio a ?claseTerr , skos:Concept ;
              skos:notation ?codigo ;
              skos:prefLabel ?nombre ;
              skos:inScheme ?esquema .
  ?territorio skos:broader ?territorioPadre .

  ?obs a qb:Observation ;
       qb:dataSet <http://lod.ine.es/recurso/cubes/31105> ;
       ?dimensionTerr ?territorio ;
       sdmx-dimension:refPeriod ?periodoLit ;
       sdmx-attribute:unitMeasure ?unidad ;
       ?propMedida ?valor .
}
WHERE {
  SERVICE <x-sparql-anything:location=data/raw/31105-clean.csv,csv.headers=true,csv.delimiter=;,charset=UTF-8> {
    ?row xyz:Municipios                ?muniRaw ;
         xyz:Distritos                 ?distRaw ;
         xyz:Secciones                 ?secRaw ;
         xyz:Indicadores_demograficos  ?indicadorRaw ;
         xyz:Periodo                   ?periodoRaw ;
         xyz:Total                     ?totalRaw .
  }

  # === Limpieza de whitespace en columnas relevantes ===
  BIND (REPLACE(?muniRaw,  "^\\s+|\\s+$", "") AS ?muniLimpio)
  BIND (REPLACE(?distRaw,  "^\\s+|\\s+$", "") AS ?distLimpio)
  BIND (REPLACE(?secRaw,   "^\\s+|\\s+$", "") AS ?secLimpio)
  BIND (REPLACE(?totalRaw, "^\\s+|\\s+$", "") AS ?totalLimpio)

  # === Filtrar vacíos y secreto estadístico ===
  FILTER (?totalLimpio != "")
  FILTER (?totalLimpio != "..")
  FILTER (?totalLimpio != ".")
  FILTER (?totalLimpio != "-")

  # === Identificación del nivel territorial ===
  BIND (
    IF (?secLimpio  != "", "seccion",
    IF (?distLimpio != "", "distrito",
    IF (?muniLimpio != "", "municipio",
                           "ninguno")))
    AS ?nivel)
  FILTER (?nivel != "ninguno")

  BIND (
    IF (?nivel = "seccion",   ?secLimpio,
    IF (?nivel = "distrito",  ?distLimpio,
                              ?muniLimpio))
    AS ?territorioRaw)

  BIND (REPLACE(?territorioRaw, "^([0-9]+)\\s+.*$", "$1") AS ?codigo)
  BIND (REPLACE(?territorioRaw, "^[0-9]+\\s+(.*)$", "$1") AS ?nombre)

  # === Filtro Madrid (28079) ===
  FILTER (
    (?nivel = "municipio" && ?codigo = "28079") ||
    (?nivel = "distrito"  && STRSTARTS(?codigo, "28079")) ||
    (?nivel = "seccion"   && STRSTARTS(?codigo, "28079"))
  )

  # === URI, clase, dimensión, esquema ===
  BIND (
    IF (?nivel = "seccion",
        IRI(CONCAT("http://lod.ine.es/kos/secciones-censales/SECCIONES_CENSALES/", ?codigo)),
    IF (?nivel = "distrito",
        IRI(CONCAT("http://lod.ine.es/kos/distritos/DISTRITOS/", ?codigo)),
        IRI(CONCAT("http://lod.ine.es/kos/municipios/MUNICIPIOS/", ?codigo))))
    AS ?territorio)

  BIND (
    IF (?nivel = "seccion",   ine:CensusSection,
    IF (?nivel = "distrito",  ine:District,
                              ine:municipality))
    AS ?claseTerr)

  BIND (
    IF (?nivel = "seccion",   ine:censusSection,
    IF (?nivel = "distrito",  ine:districts,
                              ine:municipality))
    AS ?dimensionTerr)

  BIND (
    IF (?nivel = "seccion",   IRI("http://lod.ine.es/kos/secciones-censales/SECCIONES_CENSALES"),
    IF (?nivel = "distrito",  IRI("http://lod.ine.es/kos/distritos/DISTRITOS"),
                              IRI("http://lod.ine.es/kos/municipios/MUNICIPIOS")))
    AS ?esquema)

  BIND (
    IF (?nivel = "seccion",
        IRI(CONCAT("http://lod.ine.es/kos/distritos/DISTRITOS/", SUBSTR(?codigo, 1, 7))),
    IF (?nivel = "distrito",
        IRI(CONCAT("http://lod.ine.es/kos/municipios/MUNICIPIOS/", SUBSTR(?codigo, 1, 5))),
        ?codigo))
    AS ?territorioPadre)
  FILTER (?nivel != "municipio" || ?territorioPadre != ?codigo)

  # === Periodo ===
  BIND (STRDT(?periodoRaw, xsd:gYear) AS ?periodoLit)

  # === Mapeo indicador → propiedad QB (específico de la 31105) ===
  BIND (
    IF (?indicadorRaw = "Edad media de la poblacion",               ine:meanAge,
    IF (?indicadorRaw = "Porcentaje de poblacion menor de 18 anos", ine:percentageOfYoungPopulation,
    IF (?indicadorRaw = "Porcentaje de poblacion de 65 y mas anos", ine:percentageOfElderlyPopulation,
    IF (?indicadorRaw = "Tamano medio del hogar",                   ine:meanHouseholdSize,
    IF (?indicadorRaw = "Porcentaje de hogares unipersonales",      ine:percentageOfSingleHouseholds,
    IF (?indicadorRaw = "Poblacion",                                ine:totalPopulation,
    IF (?indicadorRaw = "Porcentaje de poblacion espanola",         ine:percentageOfSpanishPopulation,
                                                                    ine:meanAge)))))))
    AS ?propMedida)

  # === Unidad según la medida ===
  BIND (
    IF (?propMedida = ine:totalPopulation,                "PERSONS",
    IF (?propMedida = ine:meanAge,                        "YEARS",
    IF (?propMedida = ine:meanHouseholdSize,              "PERSONS_PER_HH",
                                                          "PCT")))
    AS ?unidad)

  # === Conversión del valor numérico ===
  BIND (REPLACE(?totalLimpio, "\\.", "") AS ?sinMiles)
  BIND (REPLACE(?sinMiles, ",", ".") AS ?totalNorm)
  FILTER (REGEX(?totalNorm, "^-?[0-9]+(\\.[0-9]+)?$"))
  BIND (STRDT(?totalNorm, xsd:decimal) AS ?valor)

  # === URI de la observación ===
  BIND (
    IF (?propMedida = ine:meanAge,                          "edadMedia",
    IF (?propMedida = ine:percentageOfYoungPopulation,      "pctMenor18",
    IF (?propMedida = ine:percentageOfElderlyPopulation,    "pctMayor65",
    IF (?propMedida = ine:meanHouseholdSize,                "tamHogar",
    IF (?propMedida = ine:percentageOfSingleHouseholds,     "hogaresUni",
    IF (?propMedida = ine:totalPopulation,                  "poblacion",
    IF (?propMedida = ine:percentageOfSpanishPopulation,    "pctEspanola",
                                                            "otro")))))))
    AS ?slugMedida)
BIND (IRI(CONCAT(
    "http://lod.ine.es/recurso/cubes/31105/o",
    STRUUID())) AS ?obs)
}