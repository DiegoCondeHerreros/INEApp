##############################################################################
# CONSTRUCT 1 — Viviendas turísticas (ine:touristDwellings)
# Fuente: Tabla 5 VUT — CSV de secciones censales
##############################################################################

PREFIX xyz:             <http://sparql.xyz/facade-x/data/>
PREFIX qb:              <http://purl.org/linked-data/cube#>
PREFIX ine:             <https://lod.ine.es/def/vocabulary/>
PREFIX sdmx-dimension:  <http://purl.org/linked-data/sdmx/2009/dimension#>
PREFIX sdmx-attribute:  <http://purl.org/linked-data/sdmx/2009/attribute#>
PREFIX skos:            <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd:             <http://www.w3.org/2001/XMLSchema#>
PREFIX qb:              <http://purl.org/linked-data/cube#>


CONSTRUCT {
  ?secCensal a ine:CensusSection , skos:Concept ;
             skos:notation ?cusec ;
             skos:inScheme <http://lod.ine.es/kos/secciones-censales/SECCIONES_CENSALES> ;
             skos:broader ?distrito .

  ?obs a qb:Observation ;
       qb:dataSet <http://lod.ine.es/recurso/cubes/viv-tur> ;
       ine:censusSection ?secCensal ;
       sdmx-dimension:refPeriod ?periodoLit ;
       sdmx-attribute:unitMeasure "DWELLINGS" ;
       ine:touristDwellings ?valor .
}
WHERE {
  SERVICE <x-sparql-anything:location=data/raw/5-clean.csv,csv.headers=true,csv.delimiter=;,charset=UTF-8> {
    [] xyz:CUSEC                       ?cusecRaw ;
       xyz:MUN                         ?munRaw ;
       xyz:NOTA1                       ?nota1Raw ;
       xyz:vivienda_turistica          ?vivRaw ;
       xyz:PERIODO                     ?periodoRaw .
  }

  # Limpieza whitespace
  BIND (REPLACE(?cusecRaw,  "^\\s+|\\s+$", "") AS ?cusec)
  BIND (REPLACE(?munRaw,    "^\\s+|\\s+$", "") AS ?mun)
  BIND (REPLACE(?nota1Raw,  "^\\s+|\\s+$", "") AS ?nota1)
  BIND (REPLACE(?vivRaw,    "^\\s+|\\s+$", "") AS ?vivLimpio)

  # Filtro Madrid
  FILTER (?mun = "28079")

  # Filtro dato válido: nota vacía significa que el dato tiene sentido
  # (incluye 0, que es válido: sección sin viviendas turísticas)
  FILTER (?nota1 = "")

  # URI de la sección censal
  BIND (IRI(CONCAT(
    "http://lod.ine.es/kos/secciones-censales/SECCIONES_CENSALES/", ?cusec))
    AS ?secCensal)

  # Enlace skos:broader al distrito (primeros 7 dígitos del CUSEC)
  BIND (IRI(CONCAT(
    "http://lod.ine.es/kos/distritos/DISTRITOS/", SUBSTR(?cusec, 1, 7)))
    AS ?distrito)

  # Conversión del periodo: "2025M11" → "2025-11"^^xsd:gYearMonth
  BIND (REPLACE(?periodoRaw, "M", "-") AS ?periodoStr)
  BIND (STRDT(?periodoStr, xsd:gYearMonth) AS ?periodoLit)

  # Conversión del valor numérico
  BIND (REPLACE(?vivLimpio, "\\.", "") AS ?sinMiles)
  BIND (REPLACE(?sinMiles, ",", ".") AS ?vivNorm)
  FILTER (REGEX(?vivNorm, "^-?[0-9]+(\\.[0-9]+)?$"))
  BIND (STRDT(?vivNorm, xsd:integer) AS ?valor)

  # URI de la observación
  BIND (IRI(CONCAT(
    "http://lod.ine.es/recurso/cubes/viv-tur/o", STRUUID())) AS ?obs)
}