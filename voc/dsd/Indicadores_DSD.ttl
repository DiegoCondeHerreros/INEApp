##############################################################################
# Cubo de Indicadores de Gentrificación — DSD
##############################################################################

@prefix ine:            <https://lod.ine.es/def/vocabulary/> .
@prefix qb:             <http://purl.org/linked-data/cube#> .
@prefix sdmx-dimension: <http://purl.org/linked-data/sdmx/2009/dimension#> .
@prefix sdmx-attribute: <http://purl.org/linked-data/sdmx/2009/attribute#> .
@prefix dcterms:        <http://purl.org/dc/terms/> .
@prefix rdfs:           <http://www.w3.org/2000/01/rdf-schema#> .


<http://lod.ine.es/recurso/cubes/gentrificacion> a qb:DataSet ;
    rdfs:label "Indicadores de gentrificación a escala de sección censal — Madrid"@es ;
    qb:structure <http://lod.ine.es/recurso/cubes/gentrificacion/dsd> ;
    dcterms:publisher <http://www.ine.es/> .

<http://lod.ine.es/recurso/cubes/gentrificacion/dsd> a qb:DataStructureDefinition ;
    qb:component
        [ qb:dimension ine:censusSection ;        qb:order 1 ] ,
        [ qb:dimension sdmx-dimension:refPeriod ; qb:order 2 ] ,
        [ qb:dimension ine:indicator ;            qb:order 3 ] ,
        [ qb:measure   ine:gentrificationIndex ] ,
        [ qb:attribute sdmx-attribute:unitMeasure ; qb:componentRequired true ] .